{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ep18-family-kitchen",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ep18-family-kitchen",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations-fresh"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "KITCHEN",
        "class_name": "KitchenDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "KitchenDO"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "0 20 * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}
